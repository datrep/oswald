{
  "description": "Vendor tool hooks (manifest-driven - add a vendor by editing JSON, no code change). 'match' = case-insensitive substrings matched against hardware names; FIRST entry wins. 'displayName' = keyword matched against installed-program names (registry) to locate the real exe when the default path drifts. 'installPaths' = fast exact hints (${env:...} expanded). 'infoUrl' opens in the browser (patch mode) when the tool is missing. 'note' is shown to the user.",
  "ssd": [
    {
      "vendor": "Kingston",
      "match": ["kingston"],
      "displayName": "Kingston SSD Manager",
      "tool": "Kingston SSD Manager",
      "installPaths": ["${env:ProgramFiles(x86)}\\Kingston\\KSM\\KSM.exe"],
      "infoUrl": "https://www.kingston.com/en/support/technical/ksm",
      "note": "Firmware update is in the app's Firmware Update tab."
    },
    {
      "vendor": "Samsung",
      "match": ["samsung"],
      "displayName": "Samsung Magician",
      "tool": "Samsung Magician",
      "installPaths": ["${env:ProgramFiles(x86)}\\Samsung\\Samsung Magician\\SamsungMagician.exe"],
      "infoUrl": "https://semiconductor.samsung.com/consumer-storage/magician/",
      "note": "Update firmware via Samsung Magician."
    },
    {
      "vendor": "Crucial",
      "match": ["crucial", "ct"],
      "displayName": "Crucial Storage Executive",
      "tool": "Crucial Storage Executive",
      "installPaths": ["${env:ProgramFiles}\\Crucial\\Crucial Storage Executive\\CrucialStorageExecutive.exe"],
      "infoUrl": "https://www.crucial.com/support/storage-executive",
      "note": "Drive Details -> Firmware Update."
    },
    {
      "vendor": "Western Digital",
      "match": ["western digital", "wdc", "wd "],
      "displayName": "WD Dashboard",
      "tool": "WD Dashboard",
      "installPaths": ["${env:ProgramFiles(x86)}\\Western Digital\\WD Dashboard\\WD Dashboard.exe"],
      "infoUrl": "https://support-en.wd.com/",
      "note": "Firmware updates via WD Dashboard."
    },
    {
      "vendor": "Seagate",
      "match": ["seagate", "st"],
      "displayName": "SeaTools",
      "tool": "SeaTools",
      "installPaths": ["${env:ProgramFiles(x86)}\\Seagate\\SeaTools for Windows\\SeaToolsforWindows.exe"],
      "infoUrl": "https://www.seagate.com/support/downloads/seatools/",
      "note": "Firmware updates via SeaTools (very old drives may need SeaTools Bootable)."
    },
    {
      "vendor": "Intel",
      "match": ["intel"],
      "displayName": "Memory and Storage Tool",
      "tool": "Intel Memory and Storage Tool",
      "installPaths": ["${env:ProgramFiles}\\Intel\\Intel(R) Memory and Storage Tool\\intelmas.exe"],
      "infoUrl": "https://www.intel.com/content/www/us/en/support/detect.html",
      "note": "Intel MAS updates Intel SSD firmware."
    }
  ],
  "gpu": [
