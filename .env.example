# ============================================================
# Oswald — environment template
# ============================================================
# Copy this file to `.env` (or run scripts/bootstrap-fresh-machine.ps1,
# which generates `.env` automatically with strong random secrets).
#
# The app loads this file via dotenv at startup. Do NOT commit `.env`.

# --- HTTP server (dashboard) ---------------------------------
# TCP port for the plain-HTTP dashboard.
PORT=8080
# TCP port for the HTTPS dashboard (self-signed cert auto-generated).
HTTPS_PORT=8443
# Address the dashboard binds to. 0.0.0.0 = all interfaces.
# start-detached.ps1 uses LOCAL_SERVER_HOST as SERVER_HOST if set.
SERVER_HOST=0.0.0.0
LOCAL_SERVER_HOST=0.0.0.0
# ZeroTier/LAN address other devices use to reach this machine (optional).
REMOTE_SERVER_HOST=0.0.0.0

# --- SQL Server ----------------------------------------------
# The app connects directly to server,port (no instance-name resolution,
# so SQL Server must listen on TCP and DB_PORT must match its static port).
DB_SERVER=localhost
# SQL Server instance name (informational — the app uses server,port above).
DB_INSTANCE=SQLEXPRESS
DB_PORT=1433
DB_DATABASE=DB_Oswald
DB_USER=api_user
# Generated by the bootstrap script. Keep in sync with the SQL login.
DB_PASSWORD=change_me

# --- Authentication ------------------------------------------
# JWT signing secret. Generate one:  node -e "require('crypto').randomBytes(48).toString('hex')"
JWT_SECRET=change_me

# --- Fileserver overrides (optional) --------------------------
# The fileserver (fileserver/) reads fileserver/config.json first; these env
# vars override it. Uncomment only what you need.
#FILESERVER_PORT=8090
#FILESERVER_HOST=0.0.0.0
#FILESERVER_DASHBOARD_BASE=http://localhost:8080
#FILESERVER_ROOT_PATH=C:\absolute\path\to\resources
#FILESERVER_ROOT_ID=data
#FILESERVER_ROOT_NAME=Data
#FILESERVER_TLS=0
#FILESERVER_MIRROR_PATH=C:\absolute\path\to\mirror
#FILESERVER_MIRROR_SOURCE=data
#FILESERVER_MIRROR_READONLY=1
#FILESERVER_SYNC_SOURCE=
#FILESERVER_SYNC_DEST=
#FILESERVER_SYNC_DELETE=0
#FILESERVER_SYNC_INTERVAL=0
#FILESERVER_THUMB_CACHE=C:\absolute\path\to\thumbs

# --- Misc -----------------------------------------------------
# development shows error stacks in JSON responses.
NODE_ENV=production
# fileserver: force Content-Disposition: attachment for everything (1/0).
#DL=0
